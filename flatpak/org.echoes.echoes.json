{
    "app-id": "org.echoes.echoes",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "echoes",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",

        "--share=network",

        "--talk-name=org.freedesktop.secrets",

        "--talk-name=ca.desrt.dconf",
        "--filesystem=xdg-run/dconf",
        "--filesystem=~/.config/dconf:ro"
    ],
    "modules": [
        "shared-modules/gtk3/gtk3.json",
        {
            "name": "echoes",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/lib/echoes",
                "cp -r bundle/lib bundle/data /app/lib/echoes/",
                "install -Dm755 bundle/echoes /app/lib/echoes/echoes",

                "install -Dm755 echoes.sh /app/bin/echoes",

                "install -Dm644 org.echoes.echoes.desktop /app/share/applications/org.echoes.echoes.desktop",
                "install -Dm644 org.echoes.echoes.metainfo.xml /app/share/metainfo/org.echoes.echoes.metainfo.xml",

                "install -Dm644 org.echoes.echoes-128.png /app/share/icons/hicolor/128x128/apps/org.echoes.echoes.png",
                "install -Dm644 org.echoes.echoes-256.png /app/share/icons/hicolor/256x256/apps/org.echoes.echoes.png",
                "install -Dm644 org.echoes.echoes-512.png /app/share/icons/hicolor/512x512/apps/org.echoes.echoes.png"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../build/linux/x64/release/bundle",
                    "dest": "bundle"
                },
                {
                    "type": "file",
                    "path": "echoes.sh"
                },
                {
                    "type": "file",
                    "path": "org.echoes.echoes.desktop"
                },
                {
                    "type": "file",
                    "path": "org.echoes.echoes.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "org.echoes.echoes-128.png"
                },
                {
                    "type": "file",
                    "path": "org.echoes.echoes-256.png"
                },
                {
                    "type": "file",
                    "path": "org.echoes.echoes-512.png"
                }
            ]
        }
    ]
}
