<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup/transfer rules. `allowBackup="false"` in the
    manifest already disables cloud backup on all versions; these rules cover
    the newer cloud-backup and device-to-device (D2D) transfer paths too,
    excluding everything so no private notes, attachments, or the account's
    key material can leave the device through a restore/transfer flow.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
