# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code / AI-assistant tooling — local-only, not meant to be published
# with the repo (permissions, session state, project instructions).
.claude/
CLAUDE.md
.mcp.json

# Local machine/IDE configuration — developer-specific paths, never shared.
local.properties
.env
.env.*
*.env

# Signing material — never commit a keystore or its password. Also covered
# per-platform in android/.gitignore/ios/.gitignore; repeated here so the
# policy is visible without having to check nested files.
*.keystore
*.jks
key.properties
*.p12
*.mobileprovision
*.cer
